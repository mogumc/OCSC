# ===== OCS Copilot 配置示例 =====
# 复制为 .env 后按需修改。
# 优先级：真实环境变量 > .env > 内置默认值（Docker 里用 -e 传参可以压过 .env）

# HTTP 监听地址，容器内建议保持 :8080
LISTEN_ADDR=:8080

# 上游大模型 API Key
# 本地 Ollama 可留空；云端服务（DeepSeek / 通义 / 豆包等）必填
API_KEY=

# 上游大模型基础地址，OpenAI 兼容，需带 /v1 且不要以 / 结尾
# 本地 Ollama  -> http://localhost:11434/v1
# 容器访问宿主机 -> http://host.docker.internal:11434/v1
# 云端示例     -> https://api.deepseek.com/v1
BASE_URL=http://localhost:11434/v1

# 模型名称
MODEL=qwen2.5:7b

# 单次上游请求空闲超时（秒）
# 注意这不是「整次作答的总时长」：只要上游还在持续吐字就不算超时，
# 所以推理模型慢慢想也不怕被掐断，但长时间没有任何数据返回会被中断
TIMEOUT_SEC=30

# 输出解析失败后的最大重试次数
MAX_RETRIES=2

# 是否使用上游模型的流式输出（SSE），默认开启
# 只影响与上游模型的通信方式；下游 /search 返回的仍是完整 JSON，OCS 无感
# 开启后长回答不会被整体超时打断；若上游不支持流式，可设为 false
STREAM=true

# 是否接受下游传入的图片作答
# 开启后 /search 请求体可携带 images 字段，元素支持：
#   data:image/png;base64,xxxx   图片 data URI
#   https://example.com/q.png    图片直链
#   iVBORw0KGgo...               裸 base64（按 PNG 处理）
# 需上游模型支持视觉（多模态），否则请保持 false
ENABLE_VISION=false

# 下游访问令牌。留空表示不鉴权（本地自用足够）
# 私人部署到公网 / 局域网共享时强烈建议设置，否则任何人都会消耗你的模型额度
ACCESS_TOKEN=

# 携带访问令牌的请求头名，默认 Authorization
# 服务端同时接受 "Bearer <token>" 与裸 token 两种写法
AUTH_HEADER=Authorization

# 是否记住答过的题：同一道题重复提问直接返回，不消耗模型额度
CACHE_ENABLED=true

# 缓存文件位置
# Docker 部署时由 compose 指定为 /data/answer_cache.db（那一层已挂好卷）
CACHE_DB=answer_cache.db

# 命中缓存时，有多大比例重新问一次模型来刷新答案（0~1，默认 0.1）
# 作用是别让一个错误答案被永久缓存住，想彻底不刷新就设为 0
CACHE_RETRY_PROBABILITY=0.1
